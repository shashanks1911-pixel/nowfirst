# Operating Mode: 'demo' (default, works without any credentials) or 'connected'
NEXT_PUBLIC_APP_MODE=demo

# Supabase Configuration (Required for Connected Test Mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Razorpay Test Mode Credentials (Required for Connected Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Analytics Pepper / Salt for Anonymized IP Hashing
ANALYTICS_SALT=nowfirst_secure_default_pepper_2026

